@inherits LayoutComponentBase
@inject Session Session
@inject NavigationManager Nav

@if (Session.IsLoggedIn)
{
    <nav class="navbar navbar-expand navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="">SGMF</a>
        <div class="navbar-nav me-auto">
            <a class="nav-link" href="">Tablero</a>
            <a class="nav-link" href="alerts">Alertas</a>
            <a class="nav-link" href="assets">Activos</a>
            <a class="nav-link" href="workorders">Órdenes de trabajo</a>
        </div>
        <span class="navbar-text me-3">@Session.UserName <span class="badge text-bg-secondary">@Session.Role</span></span>
        <a class="btn btn-sm btn-outline-light" href="login">Salir</a>
    </nav>
}

<main class="container py-4">
    @if (allowed)
    {
        @Body
    }
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool allowed;

    protected override void OnParametersSet()
    {
        allowed = Session.IsLoggedIn || Nav.ToBaseRelativePath(Nav.Uri).StartsWith("login");
        if (!allowed) Nav.NavigateTo("login");
    }
}

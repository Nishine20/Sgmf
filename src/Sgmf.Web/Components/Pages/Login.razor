@page "/login"
@inject ApiClient Api
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Ingreso</PageTitle>

<div class="card shadow-sm mx-auto mt-5" style="max-width:380px">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">SGMF</h1>
        <p class="text-muted small">Gestión de mantenimiento y disponibilidad de flota</p>
        <div class="mb-3">
            <label class="form-label">Usuario</label>
            <input class="form-control" @bind="user" />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input type="password" class="form-control" @bind="password" />
        </div>
        <button class="btn btn-primary w-100" @onclick="Submit">Ingresar</button>
        @if (error is not null) { <div class="alert alert-danger py-2 mt-3 mb-0">@error</div> }
    </div>
</div>

@code {
    private string user = "";
    private string password = "";
    private string? error;

    protected override void OnInitialized() => Session.Clear();

    private async Task Submit()
    {
        try
        {
            Session.Set(await Api.LoginAsync(user, password));
            Nav.NavigateTo("");
        }
        catch (ApiException ex) { error = ex.Message; }
        catch (HttpRequestException) { error = "No se pudo conectar con la API."; }
    }
}

@page "/assets"
@inject ApiClient Api
@inject Session Session

<PageTitle>Activos</PageTitle>
<h1 class="h3 mb-3">Activos</h1>

@if (error is not null) { <div class="alert alert-danger py-2">@error</div> }
@if (items is null) { <p>Cargando…</p> }
else
{
    <table class="table table-sm table-bordered table-striped table-hover align-middle">
        <tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Estado</th><th>Marca / Modelo</th><th>Km</th><th>Horas</th></tr>
        @foreach (var a in items)
        {
            <tr>
                <td><a href="assets/@a.Id">@a.Code</a></td>
                <td>@a.Name</td>
                <td>@a.Type</td>
                <td><span class="badge @Fmt.StatusClass(a.Status)">@a.Status</span></td>
                <td>@a.Brand @a.Model (@a.Year)</td>
                <td>@a.CurrentKm.ToString("0.##")</td>
                <td>@a.CurrentHours.ToString("0.##")</td>
            </tr>
        }
    </table>
}

@if (Session.IsAdmin)
{
    <h2 class="h5 mt-4">Nuevo activo</h2>
    <p class="d-flex flex-wrap gap-2 align-items-center">Código <input class="form-control form-control-sm d-inline-block w-auto" @bind="code" /> Nombre <input class="form-control form-control-sm d-inline-block w-auto" @bind="name" /></p>
    <p class="d-flex flex-wrap gap-2 align-items-center">
        Tipo
        <select class="form-select form-select-sm d-inline-block w-auto" @bind="type">
            @foreach (var t in Enum.GetValues<AssetType>()) { <option value="@t">@t</option> }
        </select>
        Marca <input class="form-control form-control-sm d-inline-block w-auto" @bind="brand" /> Modelo <input class="form-control form-control-sm d-inline-block w-auto" @bind="model" />
    </p>
    <p class="d-flex flex-wrap gap-2 align-items-center">Año <input type="number" class="form-control form-control-sm d-inline-block w-auto" @bind="year" /> En servicio desde <input type="date" class="form-control form-control-sm d-inline-block w-auto" @bind="since" /></p>
    <button class="btn btn-sm btn-primary" @onclick="Create">Crear</button>
}

@code {
    private List<AssetDto>? items;
    private string? error;
    private string code = "", name = "", brand = "", model = "";
    private AssetType type = AssetType.Vehiculo;
    private int year = DateTime.Today.Year;
    private DateTime since = DateTime.Today;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { items = await Api.Assets(); }
        catch (ApiException ex) { error = ex.Message; }
    }

    private async Task Create()
    {
        error = null;
        try
        {
            await Api.CreateAsset(new AssetInput(code, name, type, brand, model, year, since));
            code = name = "";
            await Load();
        }
        catch (ApiException ex) { error = ex.Message; }
    }
}
